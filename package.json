{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode2-cliproxyapi-provider",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode v2 provider plugin for CLIProxyAPI (CPA)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mistakey/opencode2-cliproxyapi-provider.git"
  },
  "homepage": "https://github.com/Mistakey/opencode2-cliproxyapi-provider#readme",
  "bugs": {
    "url": "https://github.com/Mistakey/opencode2-cliproxyapi-provider/issues"
  },
  "keywords": ["opencode", "opencode-plugin", "cliproxyapi", "cpa", "provider"],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": ["src", "docs", "README.md", "README.zh-CN.md", "CHANGELOG.md", "SECURITY.md", "LICENSE"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.26"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17 <0.6",
    "@opentui/solid": ">=0.5.17 <0.6",
    "solid-js": ">=1.9.12 <2"
  },
  "devDependencies": {
    "@opencode/ai": "2.0.26",
    "@opencode/client": "2.0.26",
    "@opencode/schema": "2.0.26",
    "@opencode/theme": "2.0.26",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "^1.3.10",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  },
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "typecheck": "tsc --noEmit",
    "check:package": "bun scripts/package-check.mjs",
    "smoke:package": "bun scripts/package-check.mjs --host",
    "smoke:host": "bun scripts/host-smoke.mjs",
    "smoke:connection": "bun scripts/host-connection.mjs",
    "smoke:first-connect": "bun scripts/host-first-connect.mjs",
    "smoke:catalog": "bun scripts/host-catalog.mjs",
    "smoke:transport": "bun scripts/host-transport.mjs",
    "smoke:pause": "bun scripts/host-pause.mjs",
    "smoke:pause-ws": "bun scripts/host-pause-ws.mjs",
    "smoke:stats": "bun scripts/host-stats.mjs"
  },
  "opencode": {
    "supported": ">=2.0.26 <3",
    "tested": "2.0.26"
  }
}
